<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/verseId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/saffron_dark"
            android:textStyle="bold"
            android:textSize="12sp"
            tools:text="Verse 2.47" />

        <TextView
            android:id="@+id/verseSanskrit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/deep_maroon"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            tools:text="कर्मण्येवाधिकारस्ते मा फलेषु कदाचन।" />

        <TextView
            android:id="@+id/verseEnglishPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/ink"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="You have a right to perform your prescribed duties, but you are not entitled to the fruits of your actions." />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
